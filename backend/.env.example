# Copy to .env.local and fill in. Never commit .env.local.

# Optional Qwen generation fallback. Not used for embeddings.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_TOKEN=
CHAT_MODEL=qwen3.8-27b-uncensored-mlx

FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-Q

BRAVE_API_KEY=

# Primary research chat. Local Qwen is used only if this path fails.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

CORS_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8787
